<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.zarroboogs.maps">

    <!-- 权限声明 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 蓝牙权限（Android 11 及以下） -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- 蓝牙权限（Android 12+） -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 蓝牙LE权限 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:name=".MapsApplication"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/launcher"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Light">

        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <!-- 高德地图Key：请在 https://lbs.amap.com 申请（绑定本应用包名与签名SHA1），替换下方占位符 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="YOUR_AMAP_KEY" />

        <!-- 腾讯地图Key：请在 https://lbs.qq.com 申请（绑定本应用包名与签名SHA1），替换下方占位符 -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="YOUR_TENCENT_KEY" />

        <!-- 高德定位服务 — 对齐demo -->
        <service android:name="com.amap.api.location.APSService" />

        <!-- 所有页面 -->
        <activity
            android:name=".ui.CameraServerConfigActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/DarkPreferenceTheme" />
        <activity
            android:name=".ui.offlinemaps.OfflineMapActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/DarkPreferenceTheme" />
        <activity
            android:name=".ui.fuel.FuelStatsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/DarkPreferenceTheme" />
        <activity
            android:name=".ui.AboutActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/DarkPreferenceTheme" />
        <activity
            android:name=".ui.navi.NaviRouteActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".ui.navi.NaviCustomActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".ui.tencent.TencentMotorRouteActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".ui.tencent.TencentNavActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- 徒步模式：GPX/KML 轨迹导入 -->
        <activity
            android:name=".ui.hiking.GpxImportActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity
            android:name=".ui.navi.NaviSettingActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.amap.api.navi.AmapRouteActivity"
            android:launchMode="singleInstance"
            android:configChanges="orientation|keyboardHidden|screenSize|navigation"
            android:theme="@android:style/Theme.NoTitleBar" />
        <activity
            android:name=".ui.maps.MapsMainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:windowSoftInputMode="adjustPan"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BLE 前台服务 -->
        <service
            android:name=".ble.BleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 文件共享 (导出日志) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 离线地图服务 -->
        <service
            android:name=".service.OfflineMapDownloadService"
            android:enabled="true"
            android:exported="false" />

        <!-- 通知监听（抓取高德/腾讯导航通知） -->
        <service
            android:name=".service.NavNotificationListener"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>