<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_overview_vehicle"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/rounded_wellow_background"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_profile_default_image_foreground" />

    <!-- Stats Card: 车辆总数 / 总消费 -->
    <LinearLayout
        android:id="@+id/overview_stats_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:background="@drawable/rounded_dark_card_background"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_vehicle_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEB3B"
                android:textSize="30sp"
                android:textStyle="bold"
                android:text="0" />
            <TextView
                android:id="@+id/tv_vehicle_count_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="辆"
                android:textColor="#FFEB3B"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="车辆总数"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#FFEB3B"
            android:alpha="0.4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tv_total_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEB3B"
                android:textSize="30sp"
                android:textStyle="bold"
                android:text="--" />
            <TextView
                android:id="@+id/tv_total_spent_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="元"
                android:textColor="#FFEB3B"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总消费"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
