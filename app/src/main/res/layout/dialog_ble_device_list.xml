<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="400dp"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Tab 切换按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/ble_tab_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="历史设备"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:enabled="false" />

        <Button
            android:id="@+id/ble_tab_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新设备"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />
    </LinearLayout>

    <ListView
        android:id="@+id/ble_device_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:padding="4dp"
        android:minHeight="200dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/ble_btn_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="上一页"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />

        <TextView
            android:id="@+id/ble_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:text="第 1 / 1 页"
            android:textSize="14sp"
            android:textColor="#808080" />

        <Button
            android:id="@+id/ble_btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="下一页"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />

    </LinearLayout>

    <!-- 回退开关：勾选后使用 Legacy BLE 模式（Nordic 连不上时的兜底方案） -->
    <CheckBox
        android:id="@+id/ble_legacy_mode_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="使用兼容 BLE 模式"
        android:textSize="13sp"
        android:textColor="#808080" />

</LinearLayout>
