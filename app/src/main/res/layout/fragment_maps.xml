<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:orientation="vertical">

    <com.amap.api.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <View
        android:id="@+id/search_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"/>

    <org.zarroboogs.maps.widget.StatusBarView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#4C000000"/>

    <RelativeLayout
        android:id="@+id/top_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <RelativeLayout
            android:id="@+id/search_maps_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_black_background">

            <ImageButton
                android:id="@+id/left_drawer_switch"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_margin="2dp"
                android:background="@drawable/button_background_dark_selector"
                android:src="@drawable/ic_qu_appbar_back"
                android:tint="#FFFFFF"
                android:visibility="gone"/>


            <ImageButton
                android:id="@+id/cancel_search"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_margin="2dp"
                android:background="@drawable/button_background_dark_selector"
                android:src="@drawable/ic_qu_search"
                android:tint="#FFFFFF"
                tools:ignore="ContentDescription,RtlHardcoded"/>

            <EditText
                android:id="@+id/poi_search_in_maps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="5.0dip"
                android:layout_toLeftOf="@+id/cancel_search"
                android:layout_toRightOf="@+id/left_drawer_switch"
                android:background="@android:color/transparent"
                android:completionThreshold="1"
                android:cursorVisible="false"
                android:dropDownVerticalOffset="1.0dip"
                android:hint="请输入关键字"
                android:textColorHint="#808080"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text|textAutoComplete"
                android:maxHeight="50dp"
                android:maxLength="20"
                android:minHeight="50dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="16.0sp"/>

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_ble_connection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/search_maps_bar"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_black_background"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_ble_device"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/icon_device_disconnected"/>

            <TextView
                android:id="@+id/tv_ble_connect_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未连接"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/search_float_rl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:visibility="gone">


            <LinearLayout
                android:id="@+id/poi_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/search_float_content"
                android:layout_alignParentRight="true"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                tools:ignore="RtlHardcoded">

                <ImageButton
                    android:id="@+id/maps_add_btn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/circle_button_black"
                    android:src="@drawable/new_icon"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    tools:ignore="RtlHardcoded"/>

                <ImageButton
                    android:id="@+id/maps_camera_btn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/circle_button_black"
                    android:src="@drawable/ic_qu_appbar_close"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    tools:ignore="RtlHardcoded"/>

                <ImageButton
                    android:id="@+id/maps_favorite_btn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/circle_button_black"
                    android:src="@drawable/shoucangzengjia"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    tools:ignore="RtlHardcoded"/>

                <ImageButton
                    android:id="@+id/maps_drive_line_btn"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/circle_button_black"
                    android:src="@drawable/ic_navigation_arrow"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    tools:ignore="RtlHardcoded"/>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/search_float_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@drawable/rounded_black_background">

                <TextView
                    android:id="@+id/search_result_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginTop="10dp"
                    android:text="摩托罗拉大厦"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>

                <TextView
                    android:id="@+id/search_poi_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/search_result_title"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginTop="10dp"
                    android:text="地址，具体地址"
                    android:textColor="#B0B0B0"/>

                <TextView
                    android:id="@+id/search_poi_tel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/search_poi_summary"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="15dp"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="15dp"
                    android:layout_marginTop="10dp"
                    android:textColor="#B0B0B0"/>

            </RelativeLayout>

        </RelativeLayout>


        <ImageButton
            android:id="@+id/ori_compass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/search_maps_bar"
            android:layout_marginRight="36px"
            android:layout_marginTop="18px"
            android:background="@drawable/circle_button_black"
            android:padding="4dp"
            android:src="@drawable/maps_dav_compass_needle_large"/>

        <RelativeLayout
            android:id="@+id/ble_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@+id/ori_compass"
            android:layout_marginRight="36px"
            android:layout_marginTop="10px">

            <ImageButton
                android:id="@+id/ble_scan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_button_black"
                android:src="@drawable/ble"
                android:scaleType="centerInside"
                android:padding="6dp"/>

            <ImageView
                android:id="@+id/ble_connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/ble_scan_button"
                android:layout_alignRight="@+id/ble_scan_button"
                android:layout_alignBottom="@+id/ble_scan_button"
                android:layout_alignLeft="@+id/ble_scan_button"
                android:src="@drawable/ble_status_cross"
                android:scaleType="center"
                android:visibility="gone"/>

        </RelativeLayout>


        <!-- 电子围栏报警开关 -->
        <ImageButton
            android:id="@+id/motobaojing_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/cruise_voice_button"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/motobaojing"
            android:scaleType="centerInside"
            android:padding="6dp"/>

        <!-- 巡航自定义语音播报按钮 -->
        <ImageButton
            android:id="@+id/cruise_voice_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/dark_mode_toggle_btn"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/yuyinbobao"
            android:scaleType="centerInside"
            android:padding="6dp"/>

        <ImageButton
            android:id="@+id/dark_mode_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/cruise_toggle_btn"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/sun"
            android:scaleType="centerInside"
            android:padding="6dp"/>

        <ImageButton
            android:id="@+id/cruise_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/camera_toggle_btn"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/xunhang"/>

        <ImageButton
            android:id="@+id/camera_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/my_location_btn"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="12px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/camera_deposit"/>

        <!-- 收藏点位按钮 - 左下角 -->
        <ImageButton
            android:id="@+id/bookmark_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/gas_station_toggle_btn"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="12px"
            android:layout_marginLeft="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/shoucang"/>

        <!-- 加油站按钮 - 左下角 -->
        <ImageButton
            android:id="@+id/gas_station_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/toilet_toggle_btn"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="12px"
            android:layout_marginLeft="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/jiayouzhan"/>

        <!-- 厕所按钮 - 左下角 -->
        <ImageButton
            android:id="@+id/toilet_toggle_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="36px"
            android:layout_marginLeft="36px"
            android:background="@drawable/circle_button_black"
            android:src="@drawable/zhaocesuo"/>

        <ImageButton
            android:id="@+id/my_location_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="36px"
            android:layout_marginRight="36px"
            android:background="@drawable/circle_button_black"

            android:src="@drawable/ic_qu_direction_mylocation"/>

        <!-- 摄像头类型过滤悬浮窗口 -->
        <include layout="@layout/camera_filter_window" />

        <!-- 搜索建议列表（输入文字后显示） -->
        <ListView
            android:id="@+id/search_result_list_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@+id/search_maps_bar"
            android:layout_alignStart="@+id/search_maps_bar"
            android:layout_below="@+id/search_maps_bar"
            android:background="@drawable/rounded_black_background"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- 搜索面板（未输入时显示：快捷图标 + 历史 + 收藏） -->
        <include
            layout="@layout/search_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@+id/search_maps_bar"
            android:layout_alignStart="@+id/search_maps_bar"
            android:layout_below="@+id/search_maps_bar"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </RelativeLayout>


</FrameLayout>